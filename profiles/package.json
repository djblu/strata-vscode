{
  "name":"strata-profiles",
  "displayName":"Strata Connection Profiles",
  "description":"Keep named Strata server connections and API keys on your local PC for use across SSH workspaces.",
  "version":"0.1.0",
  "publisher":"djblu",
  "license":"UNLICENSED",
  "private":true,
  "engines":{"vscode":"^1.96.0"},
  "extensionKind":["ui"],
  "api":"none",
  "main":"./extension.cjs",
  "activationEvents":["onStartupFinished","onCommand:strataProfiles.pick","onCommand:strataProfiles.resolve"],
  "capabilities":{"untrustedWorkspaces":{"supported":false},"virtualWorkspaces":false},
  "repository":{"type":"git","url":"https://github.com/djblu/strata-vscode.git"},
  "contributes":{
    "commands":[
      {"command":"strataProfiles.manage","title":"Strata: Manage Local Connection Profiles"},
      {"command":"strataProfiles.pick","title":"Strata Profiles: Select Connection"},
      {"command":"strataProfiles.resolve","title":"Strata Profiles: Resolve Connection"}
    ],
    "menus":{"commandPalette":[{"command":"strataProfiles.pick","when":"false"},{"command":"strataProfiles.resolve","when":"false"}]}
  }
}
