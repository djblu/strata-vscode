{
  "name": "strata-harness",
  "displayName": "Strata Harness",
  "description": "Use the Strata coding harness in a VS Code sidebar.",
  "version": "0.1.14",
  "publisher": "djblu",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:strata.chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/djblu/strata-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository",
    "build": "esbuild src/code-blocks.cjs --bundle --minify --format=iife --global-name=CodeBlocks --outfile=media/code-blocks.js",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "strata.setApiKey",
        "title": "Strata: Set API Key"
      },
      {
        "command": "strata.addSelection",
        "title": "Strata: Add Editor Selection"
      },
      {
        "command": "strata.restart",
        "title": "Strata: Restart Harness"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata",
          "title": "Strata",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "strata": [
        {
          "type": "webview",
          "id": "strata.chat",
          "name": "Strata Harness"
        }
      ]
    },
    "configuration": {
      "title": "Strata Harness",
      "properties": {
        "strata.sourcePath": {
          "type": "string",
          "default": "/mnt/ai-models/strata-q8/source",
          "scope": "machine",
          "description": "Strata v0.2.4 source checkout on the extension host."
        },
        "strata.nodePath": {
          "type": "string",
          "default": "/home/djblu/.local/share/strata-vscode/node-v24.22.1-linux-x64/bin/node",
          "scope": "machine",
          "description": "Node.js 24 executable on the extension host."
        },
        "strata.harnessPath": {
          "type": "string",
          "default": "/home/djblu/.local/share/strata-vscode/harness/node_modules/@deepseek-ai/dsh",
          "scope": "machine",
          "description": "Installed dsh 0.2.1-alpha.3 package directory."
        },
        "strata.baseURL": {
          "type": "string",
          "default": "http://10.70.70.24:8081/v1",
          "scope": "machine",
          "description": "Inference API URL, reached from the extension host."
        },
        "strata.model": {
          "type": "string",
          "default": "swift-1.5-q4_k_m",
          "scope": "machine"
        },
        "strata.contextWindow": {
          "type": "number",
          "default": 262144,
          "minimum": 4096,
          "scope": "machine"
        },
        "strata.thinking": {
          "type": "string",
          "enum": [
            "Off",
            "Low",
            "Medium",
            "High"
          ],
          "default": "Low"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3"
  }
}
